#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043 # rc.common reads START, STOP, USE_PROCD; ash has local

START=95
STOP=10
USE_PROCD=1

APPLY=/usr/libexec/rickroll/apply
# Page settings for the portal CGIs. The portal runs as "nobody" and cannot
# read /etc/config/rickroll (mode 0600, it can contain the Wi-Fi key).
SETTINGS_DIR=/var/run/rickroll
SETTINGS=$SETTINGS_DIR/settings.json

# Write the page settings as JSON. A subshell keeps the jshn state of the
# procd message that rc.common is building.
write_settings() (
	local lang title button

	config_get lang main lang auto
	config_get title main title
	config_get button main button

	json_init
	json_add_string lang "$lang"
	json_add_string title "$title"
	json_add_string button "$button"
	json_add_string ipaddr "$1"

	umask 022
	mkdir -p "$SETTINGS_DIR" &&
		json_dump >"$SETTINGS.new" &&
		mv -f "$SETTINGS.new" "$SETTINGS"
)

start_service() {
	local enabled ipaddr portal_port dns_port

	config_load rickroll
	config_get_bool enabled main enabled 0
	if [ "$enabled" -eq 0 ]; then
		"$APPLY" down
		return 0
	fi

	# Remove the network of earlier valid settings, so that it does not
	# stay up without the portal.
	if ! "$APPLY" check; then
		logger -t rickroll -p daemon.err "settings are not valid, rickroll network removed"
		"$APPLY" down
		return 1
	fi

	"$APPLY" up || return 1

	config_get ipaddr main ipaddr 192.168.56.1
	config_get portal_port main portal_port 8080
	config_get dns_port main dns_port 5300

	write_settings "$ipaddr" || return 1

	# Bind 0.0.0.0: at boot br-rickroll can come up after this process.
	procd_open_instance portal
	procd_set_param command /usr/sbin/uhttpd -f \
		-h /usr/share/rickroll/www -x /cgi-bin -E /cgi-bin/portal \
		-p "0.0.0.0:$portal_port" \
		-n 16 -N 100 -t 600 -T 30 -k 20 -A 1 -D
	procd_set_param user nobody
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance dns
	procd_set_param command /usr/sbin/dnsmasq -k \
		-C /usr/share/rickroll/dnsmasq.conf \
		--port="$dns_port" --listen-address="$ipaddr" \
		--address="/#/$ipaddr" \
		-x /var/run/rickroll-dns.pid -u dnsmasq -g dnsmasq
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rickroll
}
