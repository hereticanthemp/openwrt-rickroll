
config rickroll 'main'
	option enabled '0'
	option ssid 'Free Public WiFi'
	option radio 'radio0'
	option encryption 'none'
	# option key ''
	option isolate '1'
	option ipaddr '192.168.56.1'
	option netmask '255.255.255.0'
	option portal_port '8080'
	option dns_port '5300'
	# Every DNS name resolves to this address. It must not be private:
	# Android reports "no internet" instead of the portal for private answers.
	option dns_answer '198.18.0.1'
	option lang 'auto'
	option title ''
	option button ''
