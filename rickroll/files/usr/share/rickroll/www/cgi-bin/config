#!/bin/sh
# Page settings as JSON: lang, title, button, ipaddr and has_media.
# /etc/init.d/rickroll writes all of them except has_media.

SETTINGS=/var/run/rickroll/settings.json
PLAYLIST=/etc/rickroll/media/index.m3u8

# shellcheck source=/dev/null
. /usr/share/libubox/jshn.sh

json_init
[ -r "$SETTINGS" ] && json_load_file "$SETTINGS"
if [ -s "$PLAYLIST" ] && [ ! -L "$PLAYLIST" ] && [ -r "$PLAYLIST" ]; then
	json_add_boolean has_media 1
else
	json_add_boolean has_media 0
fi

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n'
printf '\r\n'
json_dump
