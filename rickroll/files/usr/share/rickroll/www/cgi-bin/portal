#!/bin/sh
# Error page of the portal: send every unknown path to the portal page.
# Android treats only 200-399 as a captive portal, so never answer 404.
# The page is at port 80, which the firewall redirects to the portal port.

# shellcheck source=/dev/null
. /usr/share/libubox/jshn.sh

SETTINGS=/var/run/rickroll/settings.json

ipaddr=
[ -r "$SETTINGS" ] && json_load_file "$SETTINGS" 2>/dev/null &&
	json_get_var ipaddr ipaddr
[ -n "$ipaddr" ] || ipaddr=192.168.56.1

printf 'Status: 302 Found\r\n'
printf 'Location: http://%s/\r\n' "$ipaddr"
printf 'Cache-Control: no-store\r\n'
printf 'Content-Type: text/plain\r\n'
printf '\r\n'
