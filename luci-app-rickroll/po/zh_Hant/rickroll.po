msgstr "加密"

#: htdocs/luci-static/resources/view/rickroll.js:280
msgid "Expecting a netmask from 255.255.0.0 (/16) to 255.255.255.0 (/24)"
msgstr "請輸入 255.255.0.0（/16）到 255.255.255.0（/24）的子網路遮罩"

