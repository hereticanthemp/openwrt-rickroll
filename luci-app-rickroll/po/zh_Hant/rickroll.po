msgstr "未啟動"

#: htdocs/luci-static/resources/view/rickroll.js:214
msgid "Enable"
msgstr "啟用"

#: htdocs/luci-static/resources/view/rickroll.js:362
msgid "Enable it only where you have permission to run a Wi-Fi network."
msgstr "只在你有權架設 Wi-Fi 網路的環境啟用。"

#: htdocs/luci-static/resources/view/rickroll.js:62
msgid "Enabled"
msgstr "已啟用"

#: htdocs/luci-static/resources/view/rickroll.js:232
